# ===========================================
# CLIENT (FRONTEND) ENVIRONMENT VARIABLES
# ===========================================
# Copy file này thành .env và chỉnh nếu cần

# URL backend API (Vite proxy tới localhost:5000 mặc định)
# - Local dev:    /api  (Vite proxy sẽ forward tới http://localhost:5000)
# - Production:   https://your-api-domain.com/api
# - Custom port:  http://localhost:5001/api
VITE_API_URL=/api

# (Tùy chọn) Bật debug log chi tiết
VITE_DEBUG=false

# (Tùy chọn) Tên app hiển thị
VITE_APP_NAME=Laptop Store
