# ========== DATABASE CONFIGURATION ==========
DATABASE_URL=postgresql://username:password@localhost:5432/shopmaytinh
NODE_ENV=development
PORT=5000

# ========== JWT CONFIGURATION ==========
# JWT Secret - MUST be at least 32 characters long, random string
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_must_be_at_least_32_chars
# Access token expiry (default: 15 minutes)
JWT_EXPIRE=15m
# Refresh token expiry (default: 30 days)
JWT_REFRESH_EXPIRE=30d

# ========== CLIENT URL ==========
CLIENT_URL=http://localhost:5173

# ========== EMAIL CONFIGURATION ==========
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=no-reply@laptopluxe.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ========== BACKGROUND JOBS ==========
# Enable/disable background jobs (email queue, payment monitoring)
# Set to 'false' to disable in development
ENABLE_BACKGROUND_JOBS=true

# ========== FILE UPLOAD CONFIGURATION ==========
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# ========== PAGINATION ==========
DEFAULT_PAGE_LIMIT=20

# ========== REDIS (Optional for caching/sessions) ==========
# Used for distributed cache and session storage
REDIS_URL=redis://localhost:6379

# ========== AWS S3 (Optional for cloud storage) ==========
# If not configured, files are stored locally
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# ========== STRIPE (Optional for payment) ==========
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# ========== LOGGING ==========
LOG_LEVEL=debug
